{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "src/plugins"],
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"],
    "paths": {
      "@cv_es": ["./cv_es.json"],
      "@cv_en": ["./cv_en.json"],
      "@/*": ["src/*"]
    }
  }
}
