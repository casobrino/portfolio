---
import ThemeToggle from "@/components/ThemeToggle.astro"
import Mail from "@/icons/Mail.astro"
import Phone from "@/icons/Phone.astro"
import LinkedIn from "@/icons/LinkedIn.astro"
import GitHub from "@/icons/GitHub.astro"
import WorldMap from "@/icons/WorldMap.astro"
import { getLangFromUrl, getPageTranslations, getRoutes, getAlternatePath } from "@/i18n/utils"
import { basics as basicsEs } from "@cv_es"
import { basics as basicsEn } from "@cv_en"
import type { SocialIcon } from "@/types"

const lang = getLangFromUrl(Astro.url)
const t = getPageTranslations(lang)
const routes = getRoutes(lang)
const basics = lang === "en" ? basicsEn : basicsEs
const { name, label, image, location, profiles, phone, email } = basics
const { city, region } = location

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/"
const logoName = name.split(" ")[0]?.toUpperCase() ?? name.toUpperCase()

const links = [
  {
    href: routes.home,
    label: t.nav.home,
    match: lang === "en" ? /^\/en\/?$/ : /^\/$/,
  },
  {
    href: routes.cv,
    label: t.nav.cv,
    match: lang === "en" ? /^\/en\/cv$/ : /^\/cv$/,
  },
  {
    href: routes.portfolio,
    label: t.nav.portfolio,
    match: lang === "en" ? /^\/en\/portfolio$/ : /^\/portfolio$/,
  },
  {
    href: routes.photos,
    label: t.nav.photos,
    match: lang === "en" ? /^\/en\/photos$/ : /^\/fotos$/,
  },
]

const alternateLang = lang === "en" ? "es" : "en"
const alternatePath = getAlternatePath(currentPath, lang)

const hudDate = new Date()
  .toLocaleDateString(lang === "en" ? "en-GB" : "es-MX", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  })
  .replace(/\//g, " ")

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
}

const linkedInfo = profiles.find(({ network }) => network === "LinkedIn")
const linkedUrl = linkedInfo?.url
const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" • ")
---

<section class="cp-hero no-print" aria-label={t.home.heroAria}>
  <div class="cp-hero__bg" aria-hidden="true">
    <div class="cp-hero__skyline" />
    <div class="cp-hero__scanlines" />
  </div>

  <div class="cp-hero__header">
    <a class="cp-logo" href={routes.home} aria-label={t.nav.home}>
      <span class="cp-logo__text">{logoName}</span>
      <span class="cp-logo__sub">.dev</span>
    </a>

    <div class="cp-nav-wrap">
      <nav class="cp-nav" aria-label="Secciones">
        <div class="cp-nav__links-wrap">
          <span class="cp-nav__indicator" aria-hidden="true"></span>
          <ul class="cp-nav__links">
            {
              links.map(({ href, label, match }) => (
                <li>
                  <a
                    href={href}
                    class="cp-nav__link"
                    aria-current={match.test(currentPath) ? "page" : undefined}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="cp-nav__actions">
          <a class="cp-lang" href={alternatePath} lang={alternateLang}>
            {alternateLang.toUpperCase()}
          </a>
          <ThemeToggle />
          <div class="cp-nav__cta-pad">
            <a class="cp-cta cp-cta--nav" href={routes.cv}>
              {t.home.headerCta}
            </a>
          </div>
        </div>
      </nav>
    </div>
  </div>

  <div class="cp-hud" aria-hidden="true">
    <span class="cp-hud__line" />
    <span class="cp-hud__tag">/// {t.home.hudModule}</span>
    <span class="cp-hud__date">{hudDate}</span>
  </div>

  <div class="cp-hero__body">
    <div class="cp-hero__content">
      <p class="cp-hero__name print">{name}</p>
      <h1 class="cp-hero__title">{t.home.heroTitle}</h1>
      <p class="cp-hero__label">{label}</p>
      <p class="cp-hero__location">
        <WorldMap />
        {city}, {region}
      </p>

      <div class="cp-hero__actions">
        <a class="cp-cta cp-cta--primary" href={routes.cv}>
          {t.home.heroPrimary}
        </a>
        <a class="cp-cta cp-cta--secondary" href={routes.portfolio}>
          {t.home.heroSecondary}
        </a>
      </div>

      <footer class="cp-hero__social print">{printInfo}</footer>
      <footer class="cp-hero__social no-print">
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={`${t.home.contactEmail} ${email}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Mail />
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phone}`}
              title={`${t.home.contactPhone} ${phone}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Phone />
            </a>
          )
        }
        {
          profiles.map(({ network, url }) => {
            const Icon = SOCIAL_ICONS[network]
            if (!Icon) return null

            return (
              <a
                href={url}
                title={`${network}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon />
              </a>
            )
          })
        }
      </footer>
    </div>

    <figure class="cp-hero__figure">
      <div class="cp-hero__figure-glow" aria-hidden="true" />
      <img src={image} alt={name} width="480" height="480" />
      <div class="cp-hero__figure-glitch" aria-hidden="true" />
    </figure>
  </div>

  <div class="cp-hero__footer-hud" aria-hidden="true">
    <span>/// {t.home.heroHudStatus}</span>
    <span class="cp-hero__footer-hud-dot" />
    <span>{name.toUpperCase()}</span>
  </div>
</section>

<script>
  function setupNavIndicator() {
    const wrap = document.querySelector<HTMLElement>(".cp-nav__links-wrap")
    const list = wrap?.querySelector<HTMLElement>(".cp-nav__links")
    const indicator = wrap?.querySelector<HTMLElement>(".cp-nav__indicator")
    if (!wrap || !list || !indicator) return

    if (wrap.dataset.navReady === "true") return
    wrap.dataset.navReady = "true"

    const links = [...list.querySelectorAll<HTMLElement>(".cp-nav__link")]
    if (!links.length) return

    const activeLink =
      list.querySelector<HTMLElement>('.cp-nav__link[aria-current="page"]') ?? links[0]

    let hovering = false

    const nav = wrap.closest<HTMLElement>(".cp-nav")
    const navSkew = 24

    function moveTo(target: HTMLElement) {
      const wrapRect = wrap!.getBoundingClientRect()
      const targetRect = target.getBoundingClientRect()

      const skew = Math.min(
        24,
        Math.max(4, targetRect.height * 0.45),
        targetRect.width * 0.14,
      )

      const isFirst = links.indexOf(target) === 0
      let left = targetRect.left - wrapRect.left
      let width = targetRect.width
      let leftSkew = skew
      let rightSkew = skew

      if (isFirst && nav) {
        const navRect = nav.getBoundingClientRect()
        const extend = wrapRect.left - navRect.left
        left -= extend
        width += extend + 12
        leftSkew = navSkew
        rightSkew = navSkew
      }

      indicator!.style.width = `${width}px`
      indicator!.style.height = `${targetRect.height}px`
      indicator!.style.transform = `translate(${left}px, ${targetRect.top - wrapRect.top}px)`
      indicator!.style.clipPath = `polygon(${leftSkew}px 0, 100% 0, calc(100% - ${rightSkew}px) 100%, 0 100%)`
    }

    function syncIndicator() {
      const hovered = list!.querySelector<HTMLElement>(".cp-nav__link:hover")
      moveTo(hovering && hovered ? hovered : activeLink)
    }

    links.forEach((link) => {
      link.addEventListener("mouseenter", () => {
        hovering = true
        moveTo(link)
      })
    })

    wrap.addEventListener("mouseleave", () => {
      hovering = false
      moveTo(activeLink)
    })

    window.addEventListener("resize", syncIndicator)
    moveTo(activeLink)
  }

  setupNavIndicator()
  document.addEventListener("astro:page-load", setupNavIndicator)
</script>

<style>
  .cp-hero {
    --cp-yellow: #fcee09;
    --cp-cyan: #00ffd2;
    --cp-black: #000;
    --cp-nav-bg: rgba(0, 0, 0, 0.88);
    --cp-nav-skew: 24px;
    --cp-nav-notch: 12px;
    --cp-nav-pad: 1.1rem;

    position: relative;
    width: 100%;
    background-color: var(--cp-yellow);
    overflow: hidden;
    margin-bottom: 0;
  }

  .cp-hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cp-hero__skyline {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.05) 0%,
        transparent 12%,
        transparent 88%,
        rgba(0, 0, 0, 0.05) 100%
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 56px,
        rgba(0, 0, 0, 0.04) 56px,
        rgba(0, 0, 0, 0.04) 57px
      );
  }

  .cp-hero__skyline::before {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 55%;
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.12), transparent 70%),
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent 18px,
        rgba(0, 0, 0, 0.06) 18px,
        rgba(0, 0, 0, 0.06) 36px
      );
    mask-image: linear-gradient(to top, black 20%, transparent 100%);
  }

  .cp-hero__scanlines {
    position: absolute;
    inset: 0;
    opacity: 0.04;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.5) 2px,
      rgba(0, 0, 0, 0.5) 3px
    );
  }

  .cp-hero__header,
  .cp-hud,
  .cp-hero__body,
  .cp-hero__footer-hud {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
  }

  .cp-hero__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 2rem 0.75rem;
  }

  .cp-logo {
    display: flex;
    align-items: baseline;
    gap: 0.1rem;
    flex-shrink: 0;
    text-decoration: none;
    color: var(--cp-black);
    font-family: "Rajdhani", system-ui, sans-serif;
    line-height: 1;
    transform: skewX(-6deg);
  }

  .cp-logo__text {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cp-logo__sub {
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    opacity: 0.75;
  }

  .cp-nav-wrap {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    min-width: 0;
    filter: drop-shadow(0 0 0 2px var(--cp-black));
  }

  .cp-nav {
    display: flex;
    align-items: stretch;
    background: var(--cp-nav-bg);
    clip-path: polygon(
      var(--cp-nav-skew) 0,
      100% 0,
      100% calc(100% - var(--cp-nav-notch)),
      calc(100% - var(--cp-nav-notch)) 100%,
      0 100%
    );
    padding: 0 var(--cp-nav-pad);
    min-height: 2.75rem;
    max-width: 100%;
    overflow: hidden;
  }

  .cp-nav__links-wrap {
    position: relative;
    display: flex;
    align-items: stretch;
    align-self: stretch;
    flex: 1;
    min-width: 0;
  }

  .cp-nav__links {
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 0;
    margin: 0;
    padding: 0 0.75rem 0 0;
    list-style: none;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-self: stretch;
    height: 100%;
  }

  .cp-nav__links li {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: stretch;
    flex: 0 0 auto;
  }

  .cp-nav__cta-pad {
    align-self: stretch;
    display: flex;
    align-items: stretch;
    margin-left: 0.15rem;
    padding: 0 var(--cp-nav-pad) var(--cp-nav-pad) 0;
    border-top: 6px solid var(--cp-black);
    border-left: 10px solid var(--cp-black);
    background: var(--cp-black);
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .cp-cta--nav {
    color: var(--cp-black);
    background: var(--cp-yellow);
    align-self: stretch;
    min-height: 0;
    padding: 0 1.35rem;
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--cp-nav-notch)),
      calc(100% - var(--cp-nav-notch)) 100%,
      0 100%
    );
  }

  .cp-cta--nav:hover {
    filter: brightness(1.08);
    transform: none;
  }

  .cp-nav__indicator {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    pointer-events: none;
    background: rgba(252, 238, 9, 0.16);
    border-bottom: 2px solid var(--cp-yellow);
    clip-path: polygon(
      var(--cp-nav-skew) 0,
      100% 0,
      calc(100% - var(--cp-nav-skew)) 100%,
      0 100%
    );
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      clip-path 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, width, height;
  }

  .cp-nav__link {
    font-family: "Rajdhani", system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 2.75rem;
    padding: 0 var(--cp-nav-pad);
    transition: color 0.25s ease;
  }

  .cp-nav__link:hover,
  .cp-nav__link[aria-current="page"] {
    color: var(--cp-yellow);
  }

  .cp-nav__actions {
    display: flex;
    align-items: center;
    align-self: stretch;
    gap: 0.5rem;
    padding: 0 0 0 0.35rem;
    flex-shrink: 0;
  }

  .cp-lang {
    font-family: "Rajdhani", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #fff;
    padding: 0.35rem 0.5rem;
    opacity: 0.85;
    transition: color 0.15s ease, opacity 0.15s ease;
  }

  .cp-lang:hover {
    color: var(--cp-yellow);
    opacity: 1;
  }

  .cp-nav__actions :global(.theme-toggle) {
    width: 32px;
    height: 32px;
    border-radius: 0;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
    color: #fff;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%);
  }

  .cp-nav__actions :global(.theme-toggle:hover) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.45);
    color: var(--cp-yellow);
  }

  .cp-cta {
    font-family: "Rajdhani", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: filter 0.15s ease, transform 0.15s ease, background 0.15s ease;
    white-space: nowrap;
  }

  .cp-hud {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.4rem 2rem 0.65rem;
    font-family: Menlo, Monaco, "Courier New", monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cp-black);
  }

  .cp-hud__line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--cp-cyan), transparent);
    max-width: 120px;
  }

  .cp-hud__tag {
    color: rgba(0, 0, 0, 0.65);
  }

  .cp-hud__date {
    margin-left: auto;
    color: var(--cp-cyan);
    text-shadow: 0 0 8px rgba(0, 255, 210, 0.35);
  }

  .cp-hero__body {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: 1.5rem 2rem 2.5rem;
    min-height: clamp(380px, 52vh, 560px);
  }

  .cp-hero__content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 560px;
  }

  .cp-hero__name {
    font-family: "Rajdhani", system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.55);
  }

  .cp-hero__title {
    font-family: "Rajdhani", system-ui, sans-serif;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--cp-black);
    text-wrap: balance;
  }

  .cp-hero__label {
    font-family: "Rajdhani", system-ui, sans-serif;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 500;
    line-height: 1.35;
    color: rgba(0, 0, 0, 0.78);
    text-wrap: balance;
    max-width: 42ch;
  }

  .cp-hero__location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: Menlo, Monaco, "Courier New", monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.6);
    margin: 0;
  }

  .cp-hero__location :global(svg) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .cp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .cp-cta--primary {
    color: var(--cp-black);
    background: var(--cp-yellow);
    border: 2px solid var(--cp-black);
    padding: calc(0.85rem - 2px) 1.5rem;
    font-size: 0.85rem;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%);
  }

  .cp-cta--primary:hover {
    filter: brightness(1.15);
    transform: translateY(-2px);
  }

  .cp-cta--secondary {
    color: var(--cp-black);
    background: transparent;
    border: 2px solid var(--cp-black);
    padding: calc(0.85rem - 2px) 1.5rem;
    font-size: 0.85rem;
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
  }

  .cp-cta--secondary:hover {
    background: rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .cp-hero__social {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.75rem;
  }

  .cp-hero__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--cp-black);
    border: 2px solid var(--cp-black);
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .cp-hero__social a:hover {
    background: rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .cp-hero__social :global(svg) {
    width: 16px;
    height: 16px;
  }

  .cp-hero__figure {
    position: relative;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 280px;
  }

  .cp-hero__figure img {
    position: relative;
    z-index: 2;
    width: min(100%, 420px);
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center top;
    mask-image: linear-gradient(to left, black 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(to left, black 55%, transparent 100%);
    filter: contrast(1.05) saturate(1.1);
  }

  .cp-hero__figure-glow {
    position: absolute;
    inset: 10% 0 5% 20%;
    background: radial-gradient(ellipse at center, rgba(0, 255, 210, 0.25), transparent 65%);
    z-index: 1;
  }

  .cp-hero__figure-glitch {
    position: absolute;
    inset: 8% 5% 8% 15%;
    z-index: 3;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(0, 255, 210, 0.03) 3px,
      rgba(0, 255, 210, 0.03) 4px
    );
    mix-blend-mode: multiply;
    opacity: 0.6;
  }

  .cp-hero__footer-hud {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 2rem 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    font-family: Menlo, Monaco, "Courier New", monospace;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.5);
  }

  .cp-hero__footer-hud-dot {
    width: 6px;
    height: 6px;
    background: var(--cp-cyan);
    box-shadow: 0 0 6px var(--cp-cyan);
    flex-shrink: 0;
  }

  @media (width <= 900px) {
    .cp-hero__header {
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.25rem 0.5rem;
    }

    .cp-logo {
      justify-content: center;
    }

    .cp-nav-wrap {
      justify-content: center;
    }

    .cp-nav {
      flex-direction: column;
      clip-path: none;
      padding: 0;
      width: 100%;
      min-height: auto;
    }

    .cp-nav__indicator {
