---
import GitHub from "@/icons/GitHub.astro"
import Section from "../Section.astro"
import { ui, pages } from "../../i18n/ui"
import { getLangFromUrl } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const cvData = ui[lang]
const t = pages[lang]
const projects = cvData.projects
const title = Astro.props.title
---

<Section title={title}>
  <ul>
    {
      projects.map((project) => {
        const { url, description, highlights, name, isActive, github } = project
        const isOwn = (project as any).isOwn !== false
        const isPrivate = (project as any).isPrivate === true

        return (
          <li>
            <article>
              {github && (
                <a
                  class="github-link"
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={t.portfolio.viewCode}
                >
                  <GitHub />
                </a>
              )}
              <header>
                <div class="title-row">
                  <h3>
                    <a href={url} target="_blank" title={`Ver ${name}`}>
                      {name}
                    </a>
                  </h3>
                  <div class="badges">
                    {isActive && (
                      <span class="badge badge--active">
                        <span class="dot" />
                        {t.portfolio.active}
                      </span>
                    )}
                    {isOwn ? (
                      <span class="badge badge--own">{t.portfolio.ownProject}</span>
                    ) : (
                      <span class="badge badge--client">{t.portfolio.clientProject}</span>
                    )}
                  </div>
                </div>
                <p>{description}</p>
              </header>

              <footer>
                <div class="tags">
                  {highlights.map((highlight) => (
                    <span class="tag">{highlight}</span>
                  ))}
                </div>
                <div class="actions">
                  {!isPrivate && url && (
                    <a
                      class="chip chip--url"
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      ↗ {(() => { try { return new URL(url).hostname } catch { return url } })()}
                    </a>
                  )}
                </div>
              </footer>
            </article>
          </li>
        )
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin-inline: -16px;
  }

  article {
    position: relative;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-subtle);
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    height: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  article:hover {
    border-color: var(--color-border-strong);
    box-shadow: 0 4px 16px var(--color-shadow);
    transform: translateY(-1px);
  }

  article header {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  article h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
  }

  article h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  article h3 a:hover {
    text-decoration: underline;
  }

  .badges {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 999px;
    border: 1px solid;
    white-space: nowrap;
  }

  .badge--active {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .badge--own {
    color: var(--color-text-secondary);
    border-color: var(--color-border-strong);
    background: var(--color-bg-muted);
  }

  .badge--client {
    color: #6b9fff;
    border-color: color-mix(in srgb, #6b9fff 45%, transparent);
    background: color-mix(in srgb, #6b9fff 10%, transparent);
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
    animation: flicker 3s ease-in-out infinite;
  }

  article p {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .tag {
    border-radius: 6px;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    font-size: 0.6rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.68rem;
    font-weight: 500;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid;
    text-decoration: none;
    transition: opacity 0.15s ease;
    white-space: nowrap;
  }

  .chip:hover {
    opacity: 0.75;
  }

  .github-link {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .github-link:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .chip--url {
    color: var(--color-text-secondary);
    border-color: var(--color-border-strong);
    background: var(--color-bg-muted);
    font-family: Menlo, Monaco, monospace;
    font-size: 0.62rem;
  }

  @keyframes flicker {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  @media (width <= 700px) {
    ul {
      margin-inline: 0;
      grid-template-columns: 1fr;
    }

    article {
      border-color: var(--color-border-subtle);
      box-shadow: 0 1px 3px var(--color-shadow);
    }

    article:hover {
      transform: none;
    }
  }

  @media print {
    article {
      break-inside: avoid;
    }

    article:hover {
      transform: none;
      box-shadow: none;
    }

    .dot {
      animation: none;
    }
  }
</style>
