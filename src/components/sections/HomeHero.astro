---
import { basics } from '@cv_es'
import Section from '@/components/Section.astro'
import Mail from '@/icons/Mail.astro'
import Phone from '@/icons/Phone.astro'
import X from '@/icons/X.astro'
import LinkedIn from '@/icons/LinkedIn.astro'
import GitHub from '@/icons/GitHub.astro'
import WorldMap from '@/icons/WorldMap.astro'
import type { SocialIcon } from '@/types'
import AsciiPond from '@/components/AsciiPond.astro'

interface Props {
  cvHref: string
  cvLabel: string
}

const { cvHref, cvLabel } = Astro.props
const { name, label, image, location, profiles, phone, email } = basics
const { city, region } = location

const SOCIAL_ICONS: SocialIcon = {
  GitHub,
  LinkedIn,
  X,
}

const linkedInfo = profiles.find(({ network }) => network === 'LinkedIn')
const linkedUrl = linkedInfo?.url

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(' • ')
---

<div class='hero'>
  <AsciiPond />
  <div class='hero-content'>
    <Section>
      <div class='container' data-koi-avoid>
        <div class='info'>
          <h1>{name}</h1>
          <h2>{label}</h2>
          <span>
            <WorldMap />
            {city}, {region}
          </span>
          <footer class='print'>
            {printInfo}
          </footer>
          <footer class='no-print'>
            {
              email && (
                <a
                  href={`mailto:${email}`}
                  title={`Enviar un correo electrónico a ${name} al correo ${email}`}
                  target='_blank'
                  rel='noopener noreferrer'
                >
                  <Mail />
                </a>
              )
            }
            {
              phone && (
                <a
                  href={`tel:${phone}`}
                  title={`Llamar por teléfono a ${name} al número ${phone}`}
                  target='_blank'
                  rel='noopener noreferrer'
                >
                  <Phone />
                </a>
              )
            }
            {
              profiles.map(({ network, url }) => {
                const Icon = SOCIAL_ICONS[network]

                return (
                  <a
                    href={url}
                    title={`Visitar el perfil de ${name} en ${network}`}
                    target='_blank'
                    rel='noopener noreferrer'
                  >
                    <Icon />
                  </a>
                )
              })
            }
          </footer>
        </div>
        <figure>
          <img src={image} alt={name} />
        </figure>
      </div>
    </Section>
  </div>
  <a class='cv-link' href={cvHref}>
    {cvLabel} →
  </a>
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Viewport minus page nav (~padding + links + margin) so the CV link stays on screen */
    height: calc(100dvh - 5.5rem);
    min-height: 28rem;
    display: flex;
    flex-direction: column;
  }

  .hero :global(section) {
    margin-bottom: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }

  .cv-link {
    position: relative;
    z-index: 1;
    display: block;
    max-width: 700px;
    width: 100%;
    margin: 0 auto;
    padding: 0 0 1.5rem;
    font-size: 0.85rem;
    color: var(--color-text);
    font-family: system-ui, sans-serif;
  }

  .cv-link:hover {
    text-decoration: underline;
  }

  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-right: 32px;
  }

  h1 {
    font-size: 2rem;
  }

  h2 {
    color: var(--color-text-label);
    font-weight: 500;
    font-size: 1.1rem;
    text-wrap: balance;
  }

  img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 128px;
    border-radius: 16px;
  }

  span {
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    letter-spacing: -0.05rem;
  }

  footer {
    color: var(--color-text-tertiary);
    font-size: 0.65rem;
    display: flex;
    gap: 4px;
    margin-top: 8px;
  }

  footer a {
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    padding: 4px;
    height: 32px;
    width: 32px;
    border-radius: 6px;
    transition: all 0.3s ease;
  }

  footer a:hover {
    background: var(--color-bg-hover);
    border: 1px solid var(--color-border-strong);
  }

  @media (width <= 700px) {
    .hero {
      height: calc(100dvh - 7.5rem);
    }

    .cv-link {
      text-align: center;
      padding-bottom: 1.25rem;
    }

    .container {
      flex-direction: column-reverse;
    }

    .info {
      justify-content: center;
      align-items: center;
      padding-right: 0;
      text-align: center;
    }

    figure {
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0 auto;
    }

    h2 {
      text-wrap: balance;
    }
  }
</style>
