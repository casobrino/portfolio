---
import GitHub from "@/icons/GitHub.astro"
import type { PortfolioProject } from "@/types"
import { getPageTranslations } from "@/i18n/utils"
import { getLangFromUrl } from "@/i18n/utils"

interface Props {
  projects: PortfolioProject[]
}

const { projects } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = getPageTranslations(lang)
---

<ul class="portfolio-grid">
  {
    projects.map(({ title, description, image, tags, links, year, featured }) => (
      <li>
        <article>
          <figure>
            <img src={image} alt={title} loading="lazy" width="400" height="250" />
          </figure>
          <header>
            <div class="title-row">
              <h3>{title}</h3>
              {featured && <span class="featured">{t.portfolio.featured}</span>}
            </div>
            <time datetime={String(year)}>{year}</time>
            <p>{description}</p>
          </header>
          <footer>
            <div class="tags">
              {tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
            <div class="links">
              {links.live && (
                <a href={links.live} target="_blank" rel="noopener noreferrer">
                  {t.portfolio.viewLive}
                </a>
              )}
              {links.github && (
                <a
                  class="github-link"
                  href={links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={t.portfolio.viewCode}
                >
                  <GitHub />
                </a>
              )}
            </div>
          </footer>
        </article>
      </li>
    ))
  }
</ul>

<style>
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-inline: -16px;
  }

  article {
    border-radius: 8px;
    border: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
  }

  figure {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg-muted);
  }

  figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  header {
    padding: 16px 16px 8px;
    flex: 1;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  h3 {
    font-size: 1rem;
    color: var(--color-text);
    margin: 0;
  }

  .featured {
    font-size: 0.6rem;
    font-weight: 500;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: 4px;
    padding: 1px 6px;
    white-space: nowrap;
  }

  time {
    font-size: 0.7rem;
    color: var(--color-text-faint);
  }

  p {
    font-size: 0.75rem;
    line-height: 1.4;
    margin-top: 8px;
  }

  footer {
    padding: 8px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .tags span {
    border-radius: 6px;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    font-size: 0.6rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .links a {
    font-size: 0.75rem;
    color: var(--color-text);
  }

  .links a:hover {
    text-decoration: underline;
  }

  .github-link {
    display: flex;
    align-items: center;
  }

  @media (width <= 700px) {
    .portfolio-grid {
      margin-inline: 0;
    }

    article {
      border: none;
      box-shadow: 0 1px 1px var(--color-border-subtle);
    }
  }
</style>
