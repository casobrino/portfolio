---
import GitHub from "@/icons/GitHub.astro"
import type { PortfolioProject } from "@/types"
import { getPageTranslations } from "@/i18n/utils"
import { getLangFromUrl } from "@/i18n/utils"

interface Props {
  projects: PortfolioProject[]
}

const { projects } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = getPageTranslations(lang)
---

<ul class="portfolio-grid">
  {
    projects.map(({ title, description, image, tags, links, year, featured, isOwn, isPrivate }) => (
      <li>
        <article>
          <figure>
            <img src={image} alt={title} loading="lazy" width="400" height="250" />
            <div class="fig-overlay" />
            {links.github && (
              <a
                class="github-link"
                href={links.github}
                target="_blank"
                rel="noopener noreferrer"
                title={t.portfolio.viewCode}
              >
                <GitHub />
              </a>
            )}
          </figure>

          <div class="card-body">
            <header>
              <div class="meta-row">
                <time datetime={String(year)}>{year}</time>
                <div class="badges">
                  {featured && (
                    <span class="badge badge--featured">{t.portfolio.featured}</span>
                  )}
                  {isOwn !== false ? (
                    <span class="badge badge--own">{t.portfolio.ownProject}</span>
                  ) : (
                    <span class="badge badge--client">{t.portfolio.clientProject}</span>
                  )}
                </div>
              </div>
              <h3>{title}</h3>
              <p>{description}</p>
            </header>

            <footer>
              <div class="tags">
                {tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <div class="actions">
                {!isPrivate && links.live && (
                  <a
                    class="chip chip--live"
                    href={links.live}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="chip-dot" />
                    {t.portfolio.viewLive}
                  </a>
                )}
              </div>
            </footer>
          </div>
        </article>
      </li>
    ))
  }
</ul>

<style>
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
    margin-inline: -16px;
  }

  article {
    border-radius: 12px;
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    background: var(--color-bg-subtle);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  article:hover {
    border-color: var(--color-border-strong);
    box-shadow: 0 6px 24px var(--color-shadow);
    transform: translateY(-2px);
  }

  figure {
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-muted);
    position: relative;
  }

  .fig-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, var(--color-bg-subtle) 100%);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  article:hover .fig-overlay {
    opacity: 0.4;
  }

  figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  article:hover figure img {
    transform: scale(1.04);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 16px;
    gap: 12px;
  }

  header {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  time {
    font-size: 0.7rem;
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
  }

  .badges {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .badge {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 999px;
    border: 1px solid;
    white-space: nowrap;
  }

  .badge--featured {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .badge--own {
    color: var(--color-text-secondary);
    border-color: var(--color-border-strong);
    background: var(--color-bg-muted);
  }

  .badge--client {
    color: #6b9fff;
    border-color: color-mix(in srgb, #6b9fff 45%, transparent);
    background: color-mix(in srgb, #6b9fff 10%, transparent);
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    line-height: 1.3;
  }

  p {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .tag {
    border-radius: 6px;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    font-size: 0.6rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid;
    text-decoration: none;
    transition: opacity 0.15s ease;
    white-space: nowrap;
  }

  .chip:hover {
    opacity: 0.8;
  }

  .chip--live {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
    animation: pulse 2s ease-in-out infinite;
  }

  .github-link {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-bg) 90%, transparent);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    backdrop-filter: blur(4px);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .github-link:hover {
    background: var(--color-bg);
    border-color: var(--color-border-strong);
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @media (width <= 700px) {
    .portfolio-grid {
      margin-inline: 0;
      grid-template-columns: 1fr;
    }

    article {
      border-color: var(--color-border-subtle);
      box-shadow: 0 1px 4px var(--color-shadow);
    }

    article:hover {
      transform: none;
    }
  }

  @media print {
    article:hover {
      transform: none;
      box-shadow: none;
    }
  }
</style>
