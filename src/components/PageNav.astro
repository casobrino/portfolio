---
import ThemeToggle from '@/components/ThemeToggle.astro'
import NavHoverLinks from '@/components/nav/NavHoverLinks'
import { basics } from '@cv_es'
import { getLangFromUrl, getPageTranslations, getRoutes } from '@/i18n/utils'

const currentUrl = Astro.url
const lang = getLangFromUrl(currentUrl)
const t = getPageTranslations(lang)
const routes = getRoutes(lang)
const currentPath = currentUrl.pathname.replace(/\/$/, '') || '/'
const isHome = lang === 'en' ? /^\/en\/?$/.test(currentPath) : currentPath === '/'

const overlayItems = [
  {
    href: routes.home,
    heading: t.nav.home,
    subheading: t.nav.overlaySubs.home,
    imgSrc: basics.image,
    current: (lang === 'en' ? /^\/en\/?$/ : /^\/$/).test(currentPath),
  },
  {
    href: routes.cv,
    heading: t.nav.cv,
    subheading: t.nav.overlaySubs.cv,
    imgSrc: '/portfolio/glupit.webp',
    current: (lang === 'en' ? /^\/en\/cv$/ : /^\/cv$/).test(currentPath),
  },
  {
    href: routes.portfolio,
    heading: t.nav.portfolio,
    subheading: t.nav.overlaySubs.portfolio,
    imgSrc: '/portfolio/igendar.webp',
    current: (lang === 'en' ? /^\/en\/portfolio$/ : /^\/portfolio$/).test(currentPath),
  },
  {
    href: routes.blog,
    heading: t.nav.blog,
    subheading: t.nav.overlaySubs.blog,
    imgSrc: '/portfolio/water-them.jpg',
    current: (lang === 'en' ? /^\/en\/blog(\/.*)?$/ : /^\/blog(\/.*)?$/).test(currentPath),
  },
  {
    href: routes.photos,
    heading: t.nav.photos,
    subheading: t.nav.overlaySubs.photos,
    imgSrc: '/portfolio/instagram-spliter.webp',
    current: (lang === 'en' ? /^\/en\/photos$/ : /^\/fotos$/).test(currentPath),
  },
]

const links = [
  {
    href: routes.home,
    label: t.nav.home,
    match: lang === 'en' ? /^\/en\/?$/ : /^\/$/,
  },
  {
    href: routes.cv,
    label: t.nav.cv,
    match: lang === 'en' ? /^\/en\/cv$/ : /^\/cv$/,
  },
  {
    href: routes.portfolio,
    label: t.nav.portfolio,
    match: lang === 'en' ? /^\/en\/portfolio$/ : /^\/portfolio$/,
  },
  {
    href: routes.blog,
    label: t.nav.blog,
    match: lang === 'en' ? /^\/en\/blog(\/.*)?$/ : /^\/blog(\/.*)?$/,
  },
  {
    href: routes.photos,
    label: t.nav.photos,
    match: lang === 'en' ? /^\/en\/photos$/ : /^\/fotos$/,
  },
]
---

<nav
  class='page-nav no-print'
  aria-label='Navegación principal'
  data-scroll-overlay={isHome ? 'true' : undefined}
  data-scroll-threshold='125'
>
  <ul class='page-nav-inline'>
    {
      links.map(({ href, label, match }) => (
        <li>
          <a href={href} aria-current={match.test(currentPath) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))
    }
  </ul>
  <ThemeToggle />
</nav>

{
  isHome && (
    <div
      id='nav-overlay'
      class='nav-overlay no-print'
      hidden
      role='dialog'
      aria-modal='true'
      aria-labelledby='nav-overlay-title'
    >
      <div class='nav-overlay-backdrop' data-nav-overlay-close></div>
      <div class='nav-overlay-panel'>
        <header class='nav-overlay-header'>
          <p id='nav-overlay-title'>{t.nav.overlayTitle}</p>
          <button type='button' class='nav-overlay-close' data-nav-overlay-close aria-label={t.nav.overlayClose}>
            ✕
          </button>
        </header>
        <NavHoverLinks client:load items={overlayItems} />
        <p class='nav-overlay-hint'>{t.nav.overlayHint}</p>
      </div>
    </div>
  )
}

<script>
  const nav = document.querySelector<HTMLElement>('.page-nav[data-scroll-overlay]')
  const overlay = document.getElementById('nav-overlay')
  if (!nav || !overlay) {
    // no-op on non-home pages
  } else {
    const threshold = Number(nav.dataset.scrollThreshold ?? 125)
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const closeMs = 480
    let progress = 0
    let open = false
    let closing = false
    let resetTimer = 0
    let closeTimer = 0
    let touchStartY = 0

    const finishClose = () => {
      window.clearTimeout(closeTimer)
      open = false
      closing = false
      progress = 0
      overlay.hidden = true
      overlay.classList.remove('is-closing')
      document.body.classList.remove('nav-overlay-open')
    }

    const setOpen = (next: boolean) => {
      if (next) {
        if (open && !closing) return
        window.clearTimeout(closeTimer)
        closing = false
        open = true
        overlay.classList.remove('is-closing')
        overlay.hidden = false
        document.body.classList.add('nav-overlay-open')
        return
      }
      if (!open || closing) return
      progress = 0
      if (reduceMotion) {
        open = false
        overlay.hidden = true
        document.body.classList.remove('nav-overlay-open')
        return
      }
      closing = true
      overlay.classList.add('is-closing')
      closeTimer = window.setTimeout(finishClose, closeMs + 40)
    }

    const bumpProgress = (delta: number) => {
      if (open || delta <= 0) {
        if (delta < 0) progress = Math.max(0, progress + delta)
        return
      }
      progress += delta
      window.clearTimeout(resetTimer)
      resetTimer = window.setTimeout(() => {
        if (!open) progress = 0
      }, 420)
      if (progress >= threshold) setOpen(true)
    }

    window.addEventListener(
      'wheel',
      (event) => {
        if (open) {
          if (event.deltaY < -20) setOpen(false)
          return
        }
        // Only engage when the page can't meaningfully scroll further into content
        const atTop = window.scrollY <= 2
        if (!atTop) return
        if (event.deltaY > 0) {
          bumpProgress(event.deltaY)
          if (progress > threshold * 0.35) event.preventDefault()
        } else {
          progress = Math.max(0, progress + event.deltaY)
        }
      },
      { passive: false }
    )

    window.addEventListener(
      'touchstart',
      (event) => {
        touchStartY = event.touches[0]?.clientY ?? 0
      },
      { passive: true }
    )

    window.addEventListener(
      'touchmove',
      (event) => {
        if (open) return
        if (window.scrollY > 2) return
        const y = event.touches[0]?.clientY ?? touchStartY
        const delta = touchStartY - y
        if (delta > 0) bumpProgress(delta * 0.65)
      },
      { passive: true }
    )

    overlay.addEventListener('animationend', (event) => {
      if (event.animationName !== 'sheet-down') return
      finishClose()
    })

    overlay.querySelectorAll('[data-nav-overlay-close]').forEach((el) => {
      el.addEventListener('click', () => setOpen(false))
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) setOpen(false)
    })

    if (reduceMotion) {
      overlay.classList.add('reduce-motion')
    }
  }
</script>

<style>
  .page-nav {
    max-width: 700px;
    margin: 0 auto 32px;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .page-nav-inline {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    flex: 1;
  }

  .page-nav-inline a {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    font-family: system-ui, sans-serif;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .page-nav-inline a:hover {
    color: var(--color-text);
  }

  .page-nav-inline a[aria-current='page'] {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
    font-weight: 600;
  }

  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    align-items: stretch;
  }

  .nav-overlay[hidden] {
    display: none;
  }

  .nav-overlay-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    animation: overlay-fade 0.35s ease both;
  }

  .nav-overlay-panel {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-top: auto;
    min-height: 100%;
    padding: 1.25rem clamp(1.25rem, 6vw, 4rem) 2rem;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: visible;
    animation: sheet-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .nav-overlay-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .nav-overlay-header p {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    font-family: system-ui, sans-serif;
  }

  .nav-overlay-close {
    appearance: none;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-secondary);
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1;
  }

  .nav-overlay-close:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    background: var(--color-bg-hover);
  }

  .nav-overlay-hint {
    margin: 1.5rem 0 0;
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }

  .nav-overlay.is-closing {
    pointer-events: none;
  }

  .nav-overlay.is-closing .nav-overlay-backdrop {
    animation: overlay-fade-out 0.42s ease both;
  }

  .nav-overlay.is-closing .nav-overlay-panel {
    animation: sheet-down 0.48s cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  .nav-overlay.reduce-motion .nav-overlay-backdrop,
  .nav-overlay.reduce-motion .nav-overlay-panel,
  .nav-overlay.reduce-motion.is-closing .nav-overlay-backdrop,
  .nav-overlay.reduce-motion.is-closing .nav-overlay-panel {
    animation: none;
    opacity: 1;
    transform: none;
  }

  :global(body.nav-overlay-open) {
    overflow: hidden;
  }

  @keyframes overlay-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes sheet-up {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes overlay-fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes sheet-down {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(100%);
    }
  }

  @media (width <= 700px) {
    .page-nav {
      margin-bottom: 24px;
      flex-direction: column;
    }

    .page-nav-inline {
      gap: 1rem;
    }

    .page-nav-inline a {
      font-size: 0.8rem;
    }
  }
</style>
