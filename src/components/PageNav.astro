---
import ThemeToggle from '@/components/ThemeToggle.astro'
import { getLangFromUrl, getPageTranslations, getRoutes } from '@/i18n/utils'

const currentUrl = Astro.url
const lang = getLangFromUrl(currentUrl)
const t = getPageTranslations(lang)
const routes = getRoutes(lang)
const currentPath = currentUrl.pathname.replace(/\/$/, '') || '/'

const links = [
  {
    href: routes.home,
    label: t.nav.home,
    match: lang === 'en' ? /^\/en\/?$/ : /^\/$/,
  },
  {
    href: routes.cv,
    label: t.nav.cv,
    match: lang === 'en' ? /^\/en\/cv$/ : /^\/cv$/,
  },
  {
    href: routes.portfolio,
    label: t.nav.portfolio,
    match: lang === 'en' ? /^\/en\/portfolio$/ : /^\/portfolio$/,
  },
  {
    href: routes.blog,
    label: t.nav.blog,
    match: lang === 'en' ? /^\/en\/blog(\/.*)?$/ : /^\/blog(\/.*)?$/,
  },
  {
    href: routes.photos,
    label: t.nav.photos,
    match: lang === 'en' ? /^\/en\/photos$/ : /^\/fotos$/,
  },
]
---

<nav class="page-nav no-print" aria-label="Navegación principal">
  <ul>
    {
      links.map(({ href, label, match }) => (
        <li>
          <a href={href} aria-current={match.test(currentPath) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))
    }
  </ul>
  <ThemeToggle />
</nav>

<style>
  .page-nav {
    max-width: 700px;
    margin: 0 auto 32px;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  ul {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    flex: 1;
  }

  a {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    font-family: system-ui, sans-serif;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  a:hover {
    color: var(--color-text);
  }

  a[aria-current="page"] {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
    font-weight: 600;
  }

  @media (width <= 700px) {
    .page-nav {
      margin-bottom: 24px;
      flex-direction: column;
    }

    ul {
      gap: 1rem;
    }

    a {
      font-size: 0.8rem;
    }
  }
</style>
