---
import Layout from "@/layouts/Layout.astro"
import { getLangFromUrl, getPageTranslations, getRoutes } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)

import About from "@/components/sections/About.astro"
import PortfolioPreview from "@/components/PortfolioPreview.astro"
import PhotoPreview from "@/components/PhotoPreview.astro"
import KeyboardManager from "@/components/KeyboardManager.astro"

import { basics } from "@cv_en"
const { name, label } = basics
const t = getPageTranslations(lang)
const routes = getRoutes(lang)
const AboutTitle = "About me"
---

<Layout title={`${name} — ${label}`} header="cyberpunk">
  <main>
    <About title={AboutTitle} />
    <a class="cv-link" href={routes.cv}>
      {t.home.viewCv} →
    </a>
    <PortfolioPreview lang={lang} />
    <PhotoPreview lang={lang} />
  </main>

  <KeyboardManager lang={lang} />
</Layout>

<style>
  main {
    padding: 3rem 4rem 4rem;
    margin: auto;
    width: 100%;
    max-width: 1200px;
  }

  .cv-link {
    display: block;
    max-width: 700px;
    margin: -24px auto 48px;
    font-size: 0.85rem;
    color: var(--color-text);
    font-family: system-ui, sans-serif;
  }

  .cv-link:hover {
    text-decoration: underline;
  }

  @media (width <= 700px) {
    main {
      padding: 2rem;
    }

    .cv-link {
      margin-bottom: 38px;
      text-align: center;
    }
  }
</style>
