---
import Layout from '@/layouts/Layout.astro'
import {
  getLangFromUrl,
  getPageTranslations,
  getRoutes,
} from '../../i18n/utils'

const lang = getLangFromUrl(Astro.url)

import HomeHero from '@/components/sections/HomeHero.astro'
import PortfolioPreview from '@/components/PortfolioPreview.astro'
import PhotoPreview from '@/components/PhotoPreview.astro'
import KeyboardManager from '@/components/KeyboardManager.astro'

import { basics } from '@cv_en'
const { name, label } = basics
const t = getPageTranslations(lang)
const routes = getRoutes(lang)
---

<Layout title={`${name} — ${label}`}>
  <main>
    <HomeHero />
    <!-- <About title="About me" /> -->
    <a class="cv-link" href={routes.cv}>
      {t.home.viewCv} →
    </a>
    <PortfolioPreview lang={lang} />
    <PhotoPreview lang={lang} />
  </main>

  <KeyboardManager lang={lang} />
</Layout>

<style>
  main {
    margin: auto;
    width: 100%;
  }

  .cv-link {
    display: block;
    max-width: 700px;
    margin: -24px auto 48px;
    font-size: 0.85rem;
    color: var(--color-text);
    font-family: system-ui, sans-serif;
  }

  .cv-link:hover {
    text-decoration: underline;
  }

  @media (width <= 700px) {
    .cv-link {
      margin-bottom: 38px;
      text-align: center;
    }
  }
</style>
