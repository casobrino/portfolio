---
import Layout from '@/layouts/Layout.astro'

import HomeHero from '@/components/sections/HomeHero.astro'
import KeyboardManager from '@/components/KeyboardManager.astro'
import { getPageTranslations, getRoutes } from '@/i18n/utils'

import { basics } from '@cv_es'
const { name, label } = basics

const lang = 'es'
const t = getPageTranslations(lang)
const routes = getRoutes(lang)
---

<Layout title={`${name} — ${label}`}>
  <main>
    <HomeHero cvHref={routes.cv} cvLabel={t.home.viewCv} />
  </main>

  <KeyboardManager lang={lang} />
</Layout>

<style>
  main {
    margin: auto;
    width: 100%;
  }
</style>
