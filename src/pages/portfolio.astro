---
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import PortfolioGrid from '@/components/PortfolioGrid.astro'
import KeyboardManager from '@/components/KeyboardManager.astro'
import portfolio from '@/data/portfolio.json'
import { getPageTranslations } from '@/i18n/utils'
import { basics } from '@cv_es'
import type { PortfolioProject } from '@/types'

const lang = 'es'
const t = getPageTranslations(lang)
const { name } = basics
const projects = portfolio as PortfolioProject[]
---

<Layout title={`${t.portfolio.title} — ${name}`}>
  <main>
    <Section title={t.portfolio.title}>
      <p class="subtitle">{t.portfolio.subtitle}</p>
      <PortfolioGrid projects={projects} />
    </Section>
  </main>

  <KeyboardManager lang={lang} />
</Layout>

<style>
  main {
    padding: 4rem;
    margin: auto;
    width: 100%;
  }

  .subtitle {
    margin-bottom: 24px;
    font-size: 0.9rem;
  }

  @media (width <= 700px) {
    main {
      padding: 2rem;
    }
  }
</style>
