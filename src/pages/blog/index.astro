---
import Layout from '@/layouts/Layout.astro'
import Section from '@/components/Section.astro'
import KeyboardManager from '@/components/KeyboardManager.astro'
import { getPublishedPosts } from '@/lib/content'
import { getPageTranslations, getRoutes } from '@/i18n/utils'
import { basics } from '@cv_es'

const lang = 'es'
const t = getPageTranslations(lang)
const routes = getRoutes(lang)
const { name } = basics
const posts = await getPublishedPosts(lang)
---

<Layout title={`${t.blog.title} — ${name}`}>
  <main>
    <Section title={t.blog.title}>
      <p class='subtitle'>{t.blog.subtitle}</p>
      {
        posts.length === 0
          ? <p class='empty'>{t.blog.empty}</p>
          : (
              <ul class='post-list'>
                {posts.map((post) => (
                  <li>
                    <a href={`${routes.blog}/${post.slug}`}>
                      <h3>{post.title}</h3>
                      {post.excerpt && <p>{post.excerpt}</p>}
                      {post.published_at && (
                        <time datetime={post.published_at}>
                          {new Date(post.published_at).toLocaleDateString(lang)}
                        </time>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            )
      }
    </Section>
  </main>
  <KeyboardManager lang={lang} />
</Layout>

<style>
  main {
    padding: 4rem;
    margin: auto;
    width: 100%;
  }

  .subtitle {
    margin-bottom: 24px;
    font-size: 0.9rem;
  }

  .empty {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-list a {
    display: block;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
  }

  .post-list h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .post-list p {
    margin: 0 0 0.35rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .post-list time {
    color: var(--color-text-tertiary);
    font-size: 0.75rem;
  }

  @media (width <= 700px) {
    main {
      padding: 2rem;
    }
  }
</style>
